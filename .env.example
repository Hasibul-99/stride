# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── API ────────────────────────────────────────────────
API_PORT=3000

# ─── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://teamboard:teamboard@localhost:5432/teamboard?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Encryption (AES-256-GCM, 32-byte hex/base64 key) ───
ENCRYPTION_KEY=change-me-32-byte-encryption-key-here

# ─── S3 / MinIO ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teamboard
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── SMTP (Mailpit locally) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TeamBoard <no-reply@teamboard.local>"

# ─── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
