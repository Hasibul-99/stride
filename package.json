{
  "name": "teamboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @teamboard/api db:migrate",
    "db:studio": "pnpm --filter @teamboard/api db:studio",
    "db:seed": "pnpm --filter @teamboard/api db:seed",
    "db:generate": "pnpm --filter @teamboard/api db:generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0"
  }
}
